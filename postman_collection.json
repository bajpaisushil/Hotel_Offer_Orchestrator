              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "simulateFailure",
                  "value": "B"
                }
              ]
            },
            "description": "The mirror image: only Supplier A's catalogue survives."
          },
          "response": []
        },
        {
          "name": "Both suppliers down",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with 503', function () {",
                  "    pm.response.to.have.status(503);",
                  "});",
                  "",
                  "pm.test('explains which stage failed', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error.code).to.eql('ORCHESTRATION_FAILURE');",
                  "    pm.expect(body.error.message).to.include('All suppliers failed');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&simulateFailure=A,B",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "simulateFailure",
                  "value": "A,B"
                }
              ]
            },
            "description": "With nothing left to aggregate the workflow fails with a non retryable error and the API surfaces it as 503."
          },
          "response": []
        }
      ]
    },

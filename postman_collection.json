{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "description": "Endpoints for the hotel offer aggregation service.\n\nStart the stack with `docker compose up -d`, then run this collection against `baseUrl`. Every request carries assertions, so the collection can also be run end to end with Newman:\n\n    newman run postman_collection.json --env-var baseUrl=http://localhost:3000\n\nRun the requests in order: the supplier outage scenarios assume the earlier happy-path requests have already populated Redis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a recognised status', function () {",
                  "    pm.expect(['ok', 'degraded', 'down']).to.include(body.status);",
                  "});",
                  "",
                  "pm.test('reports on both suppliers', function () {",
                  "    pm.expect(body.dependencies).to.have.property('Supplier A');",
                  "    pm.expect(body.dependencies).to.have.property('Supplier B');",
                  "});",
                  "",
                  "pm.test('reports on redis and temporal', function () {",
                  "    pm.expect(body.dependencies).to.have.property('redis');",
                  "    pm.expect(body.dependencies).to.have.property('temporal');",
                  "});",
                  "",
                  "pm.test('status code matches the reported state', function () {",
                  "    pm.expect(pm.response.code).to.eql(body.status === 'down' ? 503 : 200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            },
            "description": "Reports the orchestrator's own status plus a live probe of both suppliers, Redis and Temporal. Returns 200 while the service can still answer requests (ok or degraded) and 503 once a critical dependency is gone."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Hotels",
      "item": [
        {
          "name": "Delhi - deduplicated best offers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('responds with 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('returns an array of offers', function () {",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('every offer has the documented shape', function () {",
                  "    body.forEach(function (offer) {",
                  "        pm.expect(offer).to.have.all.keys('name', 'price', 'supplier', 'commissionPct');",
                  "        pm.expect(offer.price).to.be.a('number');",
                  "        pm.expect(offer.supplier).to.be.oneOf(['Supplier A', 'Supplier B']);",
                  "    });",
                  "});",
                  "",
                  "pm.test('hotel names are unique', function () {",
                  "    const names = body.map(function (offer) { return offer.name.toLowerCase(); });",
                  "    pm.expect(new Set(names).size).to.eql(names.length);",
                  "});",
                  "",
                  "pm.test('results are ordered cheapest first', function () {",
                  "    const prices = body.map(function (offer) { return offer.price; });",
                  "    pm.expect(prices).to.eql(prices.slice().sort(function (a, b) { return a - b; }));",
                  "});",
                  "",
                  "pm.test('Holtin comes from Supplier B at the cheaper price', function () {",
                  "    const holtin = body.find(function (offer) { return offer.name === 'Holtin'; });",
                  "    pm.expect(holtin).to.not.be.undefined;",
                  "    pm.expect(holtin.supplier).to.eql('Supplier B');",
                  "    pm.expect(holtin.price).to.eql(5340);",
                  "});",
                  "",
                  "pm.test('Radison comes from Supplier A at the cheaper price', function () {",
                  "    const radison = body.find(function (offer) { return offer.name === 'Radison'; });",
                  "    pm.expect(radison).to.not.be.undefined;",
                  "    pm.expect(radison.supplier).to.eql('Supplier A');",
                  "    pm.expect(radison.price).to.eql(5900);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": "The main scenario. Both suppliers list Delhi hotels with overlapping names; the workflow fans out to both, keeps the cheaper offer per hotel and caches the result in Redis."
          },
          "response": []
        },
        {
          "name": "Delhi - filtered by price range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('responds with 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('served from redis', function () {",
                  "    pm.expect(pm.response.headers.get('x-result-source')).to.eql('redis');",
                  "});",
                  "",
                  "pm.test('every offer sits inside the requested range', function () {",
                  "    body.forEach(function (offer) {",
                  "        pm.expect(offer.price).to.be.at.least(5500);",
                  "        pm.expect(offer.price).to.be.at.most(11000);",
                  "    });",
                  "});",
                  "",
                  "pm.test('the cheapest Delhi hotel is excluded by the lower bound', function () {",
                  "    const names = body.map(function (offer) { return offer.name; });",
                  "    pm.expect(names).to.not.include('Holtin');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5500&maxPrice=11000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "minPrice",
                  "value": "5500"
                },
                {
                  "key": "maxPrice",
                  "value": "11000"
                }
              ]
            },
            "description": "Adds minPrice and maxPrice. The bounds are applied by Redis with ZRANGEBYSCORE over the cached price index, not in application code."
          },
          "response": []
        },
        {

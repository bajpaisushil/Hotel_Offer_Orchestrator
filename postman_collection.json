    {
      "name": "Failure scenarios",
      "item": [
        {
          "name": "Supplier A down",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('still responds with 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('flags the degraded supplier in a response header', function () {",
                  "    pm.expect(pm.response.headers.get('x-degraded-suppliers')).to.include('Supplier A');",
                  "});",
                  "",
                  "pm.test('every offer now comes from Supplier B', function () {",
                  "    pm.expect(body).to.be.an('array').that.is.not.empty;",
                  "    body.forEach(function (offer) {",
                  "        pm.expect(offer.supplier).to.eql('Supplier B');",
                  "    });",
                  "});",
                  "",
                  "pm.test('Radison falls back to the Supplier B price', function () {",
                  "    const radison = body.find(function (offer) { return offer.name === 'Radison'; });",
                  "    pm.expect(radison.price).to.eql(6150);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&simulateFailure=A",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "simulateFailure",
                  "value": "A"
                }
              ]
            },
            "description": "simulateFailure=A makes the Supplier A activity fail every attempt. The workflow retries, gives up on that branch and returns Supplier B's catalogue rather than failing the whole request."
          },
          "response": []
        },

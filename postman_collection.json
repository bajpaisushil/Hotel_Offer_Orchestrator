                  "",
                  "pm.test('every offer now comes from Supplier A', function () {",
                  "    body.forEach(function (offer) {",
                  "        pm.expect(offer.supplier).to.eql('Supplier A');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }

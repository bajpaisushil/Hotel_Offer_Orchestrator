                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('nothing below the lower bound is returned', function () {",
                  "    body.forEach(function (offer) {",
                  "        pm.expect(offer.price).to.be.at.least(10000);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=10000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
